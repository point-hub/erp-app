{
  "name": "@point-hub/erp-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p types \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "types": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@point-hub/js-utils": "^0.0.5",
    "@point-hub/papp": "^0.0.88",
    "@point-hub/vue-cookie": "^0.2.1",
    "axios": "^1.7.8",
    "cypress": "^13.16.0",
    "date-fns": "^4.1.0",
    "pinia": "^2.2.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@point-hub/preset-papp-icon": "^0.0.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@unocss/transformer-directives": "^0.64.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/eslint-plugin": "^1.1.12",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.6.0",
    "eslint": "9.15.0",
    "eslint-plugin-cypress": "^4.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.31.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.4.1",
    "start-server-and-test": "^2.0.8",
    "typescript": "~5.7.2",
    "unocss": "^0.64.1",
    "vite": "^6.0.1",
    "vitest": "^2.1.6",
    "vue-tsc": "^2.1.10"
  }
}
